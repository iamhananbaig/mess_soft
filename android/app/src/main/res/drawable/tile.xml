<?xml version="1.0" encoding="utf-8"?>
<!-- Menu item: selected = already in the order. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true" android:state_pressed="true"><shape><solid android:color="#D6E2FD" /><corners android:radius="14dp" /><stroke android:width="2dp" android:color="@color/primary" /></shape></item>
    <item android:state_selected="true"><shape><solid android:color="@color/primary_soft" /><corners android:radius="14dp" /><stroke android:width="2dp" android:color="@color/primary" /></shape></item>
    <item android:state_pressed="true"><shape><solid android:color="@color/pressed" /><corners android:radius="14dp" /><stroke android:width="1dp" android:color="@color/border" /></shape></item>
    <item><shape><solid android:color="@color/surface" /><corners android:radius="14dp" /><stroke android:width="1dp" android:color="@color/border" /></shape></item>
</selector>
