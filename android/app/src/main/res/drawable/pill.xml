<?xml version="1.0" encoding="utf-8"?>
<!-- Filter chips (cashiers, categories in Manage menu). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true"><shape><solid android:color="@color/text" /><corners android:radius="18dp" /></shape></item>
    <item android:state_pressed="true"><shape><solid android:color="@color/pressed" /><corners android:radius="18dp" /><stroke android:width="1dp" android:color="@color/border" /></shape></item>
    <item><shape><solid android:color="@color/surface" /><corners android:radius="18dp" /><stroke android:width="1dp" android:color="@color/border" /></shape></item>
</selector>
