<?xml version="1.0" encoding="utf-8"?>
<!-- Loading, empty and error states (StateView). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/state"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clickable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp"
    android:visibility="gone">

    <ProgressBar
        android:id="@+id/stateSpinner"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginBottom="16dp"
        android:indeterminateTint="@color/primary"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/stateIconBox"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/icon_circle"
        android:backgroundTint="@color/border">
        <ImageView
            android:id="@+id/stateIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:tint="@color/muted" />
    </FrameLayout>

    <TextView
        android:id="@+id/stateTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/stateMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.15"
        android:maxWidth="300dp"
        android:textColor="@color/muted"
        android:textSize="15sp" />

    <Button
        android:id="@+id/stateAction"
        style="@style/SecondaryButton"
        android:layout_width="wrap_content"
        android:layout_marginTop="20dp"
        android:minWidth="140dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:visibility="gone" />
</LinearLayout>
