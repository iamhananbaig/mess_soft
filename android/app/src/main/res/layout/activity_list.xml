<?xml version="1.0" encoding="utf-8"?>
<!-- Shared by the Sales, Void requests and Manage menu screens. Optional parts start hidden. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <include layout="@layout/view_topbar" />

    <!-- Date: ‹ day › -->
    <LinearLayout
        android:id="@+id/dateBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:visibility="gone">
        <ImageButton
            android:id="@+id/prevDay"
            style="@style/IconButton"
            android:contentDescription="Previous day"
            android:src="@drawable/ic_chevron_left" />
        <TextView
            android:id="@+id/date"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/btn_secondary"
            android:drawableStart="@drawable/ic_calendar_today"
            android:drawablePadding="8dp"
            android:drawableTint="@color/muted"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:textSize="16sp"
            android:textStyle="bold" />
        <ImageButton
            android:id="@+id/nextDay"
            style="@style/IconButton"
            android:contentDescription="Next day"
            android:src="@drawable/ic_chevron_right" />
    </LinearLayout>

    <!-- Stats strip (Sales) -->
    <LinearLayout
        android:id="@+id/stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        android:visibility="gone" />

    <HorizontalScrollView
        android:id="@+id/filtersScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:scrollbars="none"
        android:visibility="gone">
        <LinearLayout
            android:id="@+id/filters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp" />
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />
        <include layout="@layout/view_state" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/divider"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:visibility="gone">
        <Button
            android:id="@+id/bottomButton"
            style="@style/PrimaryButton" />
    </LinearLayout>
</LinearLayout>
