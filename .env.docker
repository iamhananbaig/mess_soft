# mess_soft — Docker Environment
# Copy this to .env.docker.local and fill in your values

APP_NAME="Canteen Management"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://YOUR_SERVER_IP:9090
# Generate with: php artisan key:generate --show
APP_KEY=

APP_TIMEZONE=Asia/Karachi

# Receipt header (optional — defaults shown)
# RECEIPT_CANTEEN_NAME="ISLAMABAD DIAGNOSTIC CENTRE PVT LTD"
# RECEIPT_BRANCH_NAME="Main Branch"

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Native MySQL on the VM, reached through its unix socket (mounted into the api container).
# Find the socket:  mysql -u root -p -e "select @@socket"
#   /var/run/mysqld/mysqld.sock (Debian/Ubuntu) -> MYSQL_SOCKET_DIR=/var/run/mysqld, DB_SOCKET=/var/run/mysqld/mysqld.sock
#   /var/lib/mysql/mysql.sock   (RHEL family)   -> MYSQL_SOCKET_DIR=/var/lib/mysql,  DB_SOCKET=/var/run/mysqld/mysql.sock
# DB_SOCKET is the path INSIDE the container (the directory is always mounted at /var/run/mysqld).
# The user must be allowed from 'localhost':
#   CREATE USER 'mess_user'@'localhost' IDENTIFIED BY '...';
#   GRANT ALL ON mess_soft.* TO 'mess_user'@'localhost';
# TCP instead of the socket: DB_SOCKET= (empty), DB_HOST=host.docker.internal, and MySQL must
# listen on the Docker bridge (bind-address = 127.0.0.1,172.17.0.1) with the user allowed from '172.%'.
DB_CONNECTION=mysql
MYSQL_SOCKET_DIR=/var/run/mysqld
DB_SOCKET=/var/run/mysqld/mysqld.sock
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=mess_soft
DB_USERNAME=mess_user
DB_PASSWORD=YOUR_SECURE_PASSWORD

# Run pending migrations when the api container starts (back up the database first!)
RUN_MIGRATIONS=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

CACHE_STORE=database
# No queue worker runs: any queued work executes inline
QUEUE_CONNECTION=sync

MAIL_MAILER=log
